# Copy to `.env` (Docker Compose) or `backend/.env` (local development). Never commit real values.
# Generate secrets with:  python infrastructure/scripts/generate_secrets.py

ENVIRONMENT=development            # development | test | production
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false                # MUST be true in production (HTTPS only)
TRUST_PROXY_HEADERS=false          # true only when the API is reachable exclusively through Nginx
EXPOSE_API_DOCS=false

DATABASE_URL=postgresql+psycopg://cage_app:CHANGE_ME@localhost:5432/antiquarians_cage
MIGRATION_DATABASE_URL=postgresql+psycopg://cage_owner:CHANGE_ME@localhost:5432/antiquarians_cage  # Alembic only
REDIS_URL=                          # e.g. redis://:password@localhost:6379/0 (required in production)

# 32 random bytes, base64. Keep these two keys different and store them outside the database host.
DATA_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_MIN_LENGTH=12

# Outbound mail. Without SMTP_HOST, development writes .eml files to DEV_OUTBOX_DIR instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
DEV_OUTBOX_DIR=var/outbox

# Endpoint agents
HEARTBEAT_INTERVAL_SECONDS=60
OFFLINE_THRESHOLD_SECONDS=180       # a device is "online" only if its last authenticated heartbeat is newer
INVENTORY_INTERVAL_SECONDS=3600
ENROLLMENT_TOKEN_MAX_MINUTES=1440
DEVICE_CERT_DAYS=90
DEVICE_CERT_RENEW_BEFORE_DAYS=30
DEVICE_CA_DIR=var/pki               # device-ca.crt + encrypted device-ca.key (create offline for production)
DEVICE_CA_KEY_PASSPHRASE=           # >=24 chars, required in production
AGENT_SIGNATURE_WINDOW_SECONDS=300
AGENT_REQUIRE_MTLS=false            # MUST be true in production (Nginx :8443 forwards the verified client cert)
HEARTBEAT_RETENTION_DAYS=30
COMMAND_JOB_TTL_HOURS=72              # signed policy jobs expire after this
