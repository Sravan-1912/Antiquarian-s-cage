{
  "expo": {
    "name": "Cage Authenticator",
    "slug": "cage-authenticator",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050806",
    "ios": {
      "bundleIdentifier": "com.antiquarianscage.authenticator",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Confirm sign-in approvals with Face ID.",
        "NSCameraUsageDescription": "Scan the pairing code shown in the Antiquarian's Cage console."
      }
    },
    "android": {
      "package": "com.antiquarianscage.authenticator",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050806",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing code shown in the Antiquarian's Cage console.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
